{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "description": "Tooling (CI actions, docs tooling): patch and minor updates may be merged automatically.",
      "matchManagers": ["github-actions", "npm"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "autoApprove": true
    },
    {
      "description": "Engine, Go module, and tool version updates always open a PR.",
      "matchManagers": ["go.mod", "dockerfile", "regex"],
      "automerge": false
    }
  ],
  "regexManagers": [
    {
      "fileMatch": ["^Makefile$"],
      "matchStrings": ["KUSTOMIZE_VERSION\\s*=\\s*\\K(?<currentValue>\\S+)"],
      "depName": "sigs.k8s.io/kustomize/kustomize/v5",
      "datasource": "go",
      "versioning": "semver"
    },
    {
      "fileMatch": ["^Makefile$"],
      "matchStrings": ["CONTROLLER_TOOLS_VERSION\\s*=\\s*\\K(?<currentValue>\\S+)"],
      "depName": "sigs.k8s.io/controller-tools",
      "datasource": "go",
      "versioning": "semver"
    },
    {
      "fileMatch": ["^Makefile$", "^\\.custom-gcl\\.yml$"],
      "matchStrings": [
        "GOLANGCI_LINT_VERSION\\s*=\\s*\\K(?<currentValue>\\S+)",
        "version:\\s*\\K(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depName": "github.com/golangci/golangci-lint/v2",
      "datasource": "go",
      "versioning": "semver"
    },
    {
      "fileMatch": ["^Makefile$"],
      "matchStrings": ["GO_LICENSES_VERSION\\s*=\\s*\\K(?<currentValue>\\S+)"],
      "depName": "github.com/google/go-licenses/v2",
      "datasource": "go",
      "versioning": "semver"
    },
    {
      "fileMatch": ["^Makefile$"],
      "matchStrings": ["CRD_REF_DOCS_VERSION\\s*=\\s*\\K(?<currentValue>\\S+)"],
      "depName": "github.com/elastic/crd-ref-docs",
      "datasource": "go",
      "versioning": "semver"
    },
    {
      "description": "CNMS data-plane image pins (ADR 0004 section 6): tag and digest.",
      "fileMatch": ["^internal/images/images\\.go$"],
      "matchStrings": [
        "Dovecot\\s*=\\s*\"dovecot/dovecot:(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[0-9a-f]+)\""
      ],
      "depName": "dovecot/dovecot",
      "datasource": "docker",
      "versioning": "docker"
    },
    {
      "description": "CNMS data-plane image pins (ADR 0004 section 6): tag and digest.",
      "fileMatch": ["^internal/images/images\\.go$"],
      "matchStrings": [
        "Rspamd\\s*=\\s*\"rspamd/rspamd:(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[0-9a-f]+)\""
      ],
      "depName": "rspamd/rspamd",
      "datasource": "docker",
      "versioning": "docker"
    },
    {
      "description": "CNMS data-plane image pins (ADR 0004 section 6): tag and digest.",
      "fileMatch": ["^internal/images/images\\.go$"],
      "matchStrings": [
        "Valkey\\s*=\\s*\"valkey/valkey:(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[0-9a-f]+)\""
      ],
      "depName": "valkey/valkey",
      "datasource": "docker",
      "versioning": "docker"
    },
    {
      "description": "CNMS data-plane image pins (ADR 0004 section 6): tag and digest.",
      "fileMatch": ["^internal/images/images\\.go$"],
      "matchStrings": [
        "RedisExporter\\s*=\\s*\"oliver006/redis_exporter:(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[0-9a-f]+)\""
      ],
      "depName": "oliver006/redis_exporter",
      "datasource": "docker",
      "versioning": "docker"
    },
    {
      "description": "CNMS e2e sink image pin (ADR 0004 section 7): tag and digest.",
      "fileMatch": ["^internal/images/images\\.go$"],
      "matchStrings": [
        "Mailpit\\s*=\\s*\"axllent/mailpit:(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[0-9a-f]+)\""
      ],
      "depName": "axllent/mailpit",
      "datasource": "docker",
      "versioning": "docker"
    },
    {
      "description": "CNMS-built image tags (synced with the Dockerfiles, ADR 0004).",
      "fileMatch": ["^internal/images/images\\.go$"],
      "matchStrings": ["Postfix\\s*=\\s*\"cnms/postfix:(?<currentValue>[^\"]+)\""],
      "depName": "cnms/postfix",
      "datasource": "docker",
      "versioning": "semver",
      "skipUnresolvable": true
    },
    {
      "description": "CNMS-built image tags (synced with the Dockerfiles, ADR 0004).",
      "fileMatch": ["^internal/images/images\\.go$"],
      "matchStrings": ["E2EClient\\s*=\\s*\"cnms/e2e-client:(?<currentValue>[^\"]+)\""],
      "depName": "cnms/e2e-client",
      "datasource": "docker",
      "versioning": "semver",
      "skipUnresolvable": true
    }
  ]
}

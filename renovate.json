{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":disableDependencyDashboard"
  ],
  "ignorePresets": [":ignoreModulesAndTests"],
  "ignorePaths": ["**/node_modules/**", "**/vendor/**"],
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "description": "Tooling (CI actions, docs tooling): only patch updates may be merged automatically.",
      "matchManagers": ["github-actions", "npm"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "autoApprove": true
    },
    {
      "description": "Go module, image, and tool version updates always open a PR.",
      "matchManagers": ["gomod", "dockerfile", "devcontainer", "custom.regex"],
      "automerge": false
    },
    {
      "description": "Engine updates always open a PR; golden-file tests and config validation must pass (AGENTS.md section 9).",
      "matchPackageNames": [
        "vdukhovni/postfix",
        "rspamd/rspamd",
        "dovecot/dovecot",
        "valkey/valkey"
      ],
      "automerge": false,
      "addLabels": ["engine"]
    },
    {
      "description": "Major engine updates need an ADR on config compatibility.",
      "matchPackageNames": [
        "vdukhovni/postfix",
        "rspamd/rspamd",
        "dovecot/dovecot",
        "valkey/valkey"
      ],
      "matchUpdateTypes": ["major"],
      "addLabels": ["needs-adr"]
    },
    {
      "description": "kustomize v5.8.3 requires Go 1.27 and go.mod declares 1.26; lift this cap together with the Go toolchain bump.",
      "matchPackageNames": ["sigs.k8s.io/kustomize/kustomize/v5"],
      "allowedVersions": "<5.8.3"
    },
    {
      "description": "The Postfix tarball is verified by checksum and signature, which Renovate cannot update.",
      "matchPackageNames": ["vdukhovni/postfix"],
      "prBodyNotes": [
        "Also update POSTFIX_SHA512 in images/postfix/Dockerfile and check the signing key (images/postfix/keys)."
      ]
    },
    {
      "description": "The kind binary is verified by checksum, which Renovate cannot update.",
      "matchPackageNames": ["kubernetes-sigs/kind"],
      "prBodyNotes": [
        "Also update KIND_SHA256 in .github/workflows/test-e2e.yml (kind-linux-amd64.sha256sum of the release) and KIND_NODE_IMAGE in the Makefile to a node image listed in the release notes."
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tools installed by the Makefile with go install.",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["KUSTOMIZE_VERSION\\s*\\??=\\s*(?<currentValue>\\S+)"],
      "depNameTemplate": "sigs.k8s.io/kustomize/kustomize/v5",
      "datasourceTemplate": "go",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["CONTROLLER_TOOLS_VERSION\\s*\\??=\\s*(?<currentValue>\\S+)"],
      "depNameTemplate": "sigs.k8s.io/controller-tools",
      "datasourceTemplate": "go",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "golangci-lint is pinned in the Makefile and in the custom build configuration.",
      "managerFilePatterns": ["/^Makefile$/", "/^\\.custom-gcl\\.yml$/"],
      "matchStrings": [
        "GOLANGCI_LINT_VERSION\\s*\\??=\\s*(?<currentValue>\\S+)",
        "(?m)^version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s*$"
      ],
      "depNameTemplate": "github.com/golangci/golangci-lint/v2",
      "datasourceTemplate": "go",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.custom-gcl\\.yml$/"],
      "matchStrings": [
        "module:\\s*\"sigs\\.k8s\\.io/logtools\"[\\s\\S]*?\\n\\s*version:\\s*(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "sigs.k8s.io/logtools",
      "datasourceTemplate": "go",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["GO_LICENSES_VERSION\\s*\\??=\\s*(?<currentValue>\\S+)"],
      "depNameTemplate": "github.com/google/go-licenses/v2",
      "datasourceTemplate": "go",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["CRD_REF_DOCS_VERSION\\s*\\??=\\s*(?<currentValue>\\S+)"],
      "depNameTemplate": "github.com/elastic/crd-ref-docs",
      "datasourceTemplate": "go",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Upstream images pinned by tag and digest in the images package (ADR 0004 section 6).",
      "managerFilePatterns": ["/^internal/images/images\\.go$/"],
      "matchStrings": [
        "\"(?<depName>[a-z0-9][a-z0-9./_-]*):(?<currentValue>[^\"@:]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Postfix version: the source build argument and the tags of the CNMS images built from it (ADR 0004).",
      "managerFilePatterns": [
        "/^images/postfix/Dockerfile$/",
        "/^Makefile$/",
        "/^internal/images/images\\.go$/"
      ],
      "matchStrings": [
        "ARG POSTFIX_VERSION=(?<currentValue>\\S+)",
        "cnms-(?:postfix|e2e-client):(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "vdukhovni/postfix",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "cert-manager release installed by the e2e suite.",
      "managerFilePatterns": ["/^test/utils/utils\\.go$/"],
      "matchStrings": ["certmanagerVersion\\s*=\\s*\"(?<currentValue>v[^\"]+)\""],
      "depNameTemplate": "cert-manager/cert-manager",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Renovate release used to validate this configuration in CI.",
      "managerFilePatterns": ["/^\\.github/workflows/lint\\.yml$/"],
      "matchStrings": ["RENOVATE_VERSION:\\s*(?<currentValue>\\S+)"],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "kind release installed by the e2e workflow.",
      "managerFilePatterns": ["/^\\.github/workflows/test-e2e\\.yml$/"],
      "matchStrings": ["KIND_VERSION:\\s*(?<currentValue>v\\S+)"],
      "depNameTemplate": "kubernetes-sigs/kind",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "kind node image of the e2e cluster.",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": [
        "KIND_NODE_IMAGE\\s*\\??=\\s*(?<depName>kindest/node):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}

-- CNMS-rendered Rspamd rspamd.local.lua -- do not edit.
-- Source: MailServer tenant1/mail (ADR 0013)

-- CNMS never-unsigned guard. required maps each served domain to the
-- DKIM_SIGNED options its active keys must have produced; an empty
-- list is a served domain without a key.
local required = {
}

-- Check 2 of ADR 0015, section 4.4: the header From of authenticated mail
-- must be owned by the login. "on" for the accounts the operator manages
-- (the table is read from owners_path), "off" for a directory, whose
-- addresses are outside the cluster. The mode is rendered, not guessed from
-- an empty table: a server without accounts refuses every address.
local owners_mode = "on"
local owners_path = "/etc/rspamd/cnms/from_owners"

local rspamd_logger = require 'rspamd_logger'

local skip_actions = { reject = true, drop = true, discard = true, ['soft reject'] = true }

-- owners maps every address that an account of the operator may use in the header
-- From to its login (check 2, owners_mode and owners_path are rendered above).
-- It stays nil when the table cannot be read or has a line that is not
-- "address login": the check then fails, and the error path below defers the
-- mail of logins, as for a key that cannot be read.
local owners = nil
if owners_mode == 'on' then
  local f = io.open(owners_path, 'r')
  if f then
    owners = {}
    for line in f:lines() do
      if line ~= '' and line:sub(1, 1) ~= '#' then
        local addr, login = line:match('^(%S+) (%S+)$')
        if not addr then owners = nil; break end
        owners[addr] = login:lower()
      end
    end
    f:close()
  end
end

local function defer(task)
  task:set_pre_result('soft reject', 'DKIM signing unavailable, try again later', 'cnms_dkim_guard')
end

-- source reports whether CNMS signs for this client: a login, or loopback
-- (Postfix's own non-SMTP mail) with a non-empty envelope sender.
local function source(task)
  if task:get_user() then return true end
  local ip = task:get_from_ip()
  if not (ip and ip:is_valid() and (tostring(ip) == '127.0.0.1' or tostring(ip) == '::1')) then return false end
  local efrom = task:get_from('smtp')
  return (efrom and efrom[1] and efrom[1].addr and #efrom[1].addr > 0) and true or false
end

local function check(task)
  if not source(task) then return end                     -- not a signed class, or a Postfix-generated bounce

  local hfrom = task:get_from('mime')
  if hfrom and hfrom[2] then                              -- Rspamd signs no message with several From addresses
    for _, a in ipairs(hfrom) do
      if a.domain and required[a.domain:lower()] then
        return task:set_pre_result('reject', 'multiple From addresses cannot be DKIM signed', 'cnms_dkim_guard')
      end
    end
  end

  -- A login may send only with From addresses in a served domain. A domain
  -- that is missing or empty ('' is truthy in Lua) is not in the table.
  if task:get_user() then
    local ok = hfrom and hfrom[1]
    for _, a in ipairs(hfrom or {}) do
      if not (a.domain and required[a.domain:lower()]) then ok = false end
    end
    if not ok then
      return task:set_pre_result('reject', 'From must be an address in a served domain', 'cnms_dkim_guard')
    end
    -- Check 2: every From address is owned by the login. The whole address is
    -- lower-cased, as Postfix does for the envelope sender.
    if owners_mode == 'on' then
      if not owners then error('the table of the owned From addresses cannot be read') end
      local login = tostring(task:get_user()):lower()
      for _, a in ipairs(hfrom) do
        if owners[(a.addr or ''):lower()] ~= login then
          return task:set_pre_result('reject', 'From address is not owned by the login', 'cnms_dkim_guard')
        end
      end
    end
  end
  if hfrom and hfrom[2] then return end                   -- loopback, several From addresses, none served
  if not (hfrom and hfrom[1] and hfrom[1].domain) then return end  -- loopback without a From: Rspamd does not sign either
  local want = required[hfrom[1].domain:lower()]
  if not want then return end                             -- not a served domain

  if skip_actions[task:get_metric_action()] then return end  -- message is not leaving

  local have = {}
  local sym = task:get_symbol('DKIM_SIGNED')
  for _, o in ipairs((sym and sym[1] and sym[1].options) or {}) do have[o] = true end
  if #want == 0 then return defer(task) end               -- served domain without a key
  for _, w in ipairs(want) do
    if not have[w] then return defer(task) end
  end
end

rspamd_config:register_symbol({
  name = 'CNMS_DKIM_GUARD',
  type = 'postfilter',
  flags = 'ignore_passthrough',
  callback = function(task)
    local ok, err = pcall(check, task)
    if ok then return end
    pcall(rspamd_logger.errx, task, 'CNMS DKIM guard failed: %s', err)
    -- a guard bug must not let mail out
    local sok, signed = pcall(source, task)
    if not sok then sok, signed = pcall(task.get_user, task) end  -- source itself failed: defer logins only
    if sok and signed then defer(task) end
  end,
})

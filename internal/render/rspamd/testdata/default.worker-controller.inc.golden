# CNMS-rendered Rspamd local.d/worker-controller.inc -- do not edit.
# Source: MailServer tenant1/mail (ADR 0004)

# The controller worker serves the HTTP API. The shipped
# secure_ip (127.0.0.1 and ::1) is kept: those clients need no
# password. Every other client is refused (401) on all
# endpoints, including /metrics, because no password is
# configured: `null` (not an empty string) removes the shipped
# default password "q1", so remote access stays closed.
password = null;
# CNMS never submits messages via File/Path/Shm inputs;
# disabling them (the shipped default is true) keeps such
# inputs from being accepted.
allow_file_and_shm_inputs = false;

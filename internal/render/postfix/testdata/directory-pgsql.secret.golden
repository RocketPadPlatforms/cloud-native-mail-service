=== pgsql-alias.cf ===
# CNMS-rendered Postfix pgsql table (ADR 0015) -- do not edit.
hosts = sql.example.com:5432
user = mailro
password = p@ss$w%rd'x
dbname = maildir
query = SELECT a.target FROM "public"."cnms_aliases" a JOIN "public"."cnms_users" u ON lower(u.mail) = lower(a.target) WHERE lower(a.alias) = '%s' AND u.login ~ '^[a-z0-9][a-z0-9._-]{0,63}$' AND u.login !~ '^sa\.'
=== pgsql-mailbox.cf ===
# CNMS-rendered Postfix pgsql table (ADR 0015) -- do not edit.
hosts = sql.example.com:5432
user = mailro
password = p@ss$w%rd'x
dbname = maildir
query = SELECT mail FROM "public"."cnms_users" WHERE lower(mail) = '%s' AND login ~ '^[a-z0-9][a-z0-9._-]{0,63}$' AND login !~ '^sa\.'

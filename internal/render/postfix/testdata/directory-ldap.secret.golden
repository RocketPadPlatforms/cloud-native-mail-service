=== ca.crt ===
-----BEGIN CERTIFICATE-----
ZmFrZSBjYQ==
-----END CERTIFICATE-----
=== ldap-alias.cf ===
# CNMS-rendered Postfix ldap table (ADR 0015) -- do not edit.
server_host = ldap://ldap.example.com:389
version = 3
bind = yes
bind_dn = cn=lookup,ou=services,dc=example,dc=org
bind_pw = ldap-s3cr3t-$%'"\#
search_base = ou=people,dc=example,dc=org
scope = sub
query_filter = (&(&(objectClass=PostfixBookMailAccount)(mailEnabled=TRUE))(mailAlias=%s)(uid=*)(mail=*)(!(uid=.*))(!(uid=*/*))(!(uid=sa.*)))
result_attribute = mail
start_tls = yes
tls_require_cert = yes
tls_ca_cert_file = /etc/postfix-secret/ca.crt
timeout = 5
=== ldap-mailbox.cf ===

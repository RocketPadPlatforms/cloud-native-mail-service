search_base = ou=people,dc=example,dc=org
scope = sub
query_filter = (&(&(objectClass=PostfixBookMailAccount)(mailEnabled=TRUE))(mail=%s)(uid=*)(mail=*)(!(uid=.*))(!(uid=*/*))(!(uid=sa.*)))
